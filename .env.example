# ---------------------------------------------------------------------------
# All of these are OPTIONAL. You can enter everything in the in-app Settings
# screen instead (stored encrypted in ./data/config.enc.json).
# Any value set here OVERRIDES the Settings screen and shows as "locked" there.
# Copy to .env to use:  cp .env.example .env
# ---------------------------------------------------------------------------

# Local server
PORT=3001
# HOST=127.0.0.1          # keep it on loopback; do not expose to your network

# Encryption passphrase for data/config.enc.json.
# If unset, a random key is generated in data/.key (chmod 600).
# CONFIG_SECRET=change-me-to-a-long-random-string

# Jira Cloud
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_ACCOUNT_ID=          # auto-detected from /rest/api/3/myself if blank

# Tempo (leave empty to log through Jira's native worklog API instead)
# TEMPO_API_TOKEN=
# TEMPO_BASE_URL=https://api.tempo.io

# Round logged time UP to this many minutes (1, 5, 6, 10, 15, 30)
# ROUNDING_MINUTES=1
