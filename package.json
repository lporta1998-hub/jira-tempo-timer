{
  "name": "jira-tempo-timer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local stopwatch that logs time to Tempo Timesheets / Jira Cloud",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"node --watch-path=server server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "server": "node server/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0"
  }
}
